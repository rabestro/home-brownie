# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"

# Google Gemini API key from Google AI Studio (Free Tier)
GEMINI_API_KEY="AIzaSy..."

# Gemini model selection (default: gemini-3.1-flash-lite or gemini-1.5-flash)
GEMINI_MODEL="gemini-3.1-flash-lite"

# Service endpoints
PAPERLESS_URL="https://docs.example.com"
HOME_ASSISTANT_URL="https://home.example.com"

# Multi-tenant Family RBAC Mapping (JSON string)
# Maps Telegram User IDs to their individual system API tokens.
# If a token is omitted for a service, that user will not have access to that MCP service.
FAMILY_USERS='{
  "123456789": {
    "name": "Jegors",
    "paperless_token": "token_abc123",
    "github_token": "ghp_xyz789",
    "home_assistant_token": "eyJ..."
  }
}'
